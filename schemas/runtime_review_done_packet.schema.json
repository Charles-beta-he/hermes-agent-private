{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/runtime_review_done_packet.schema.json",
  "title": "Hermes Workflow Runtime Review Done Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "done_execution_id",
    "module_execution_id",
    "runtime_execution_id",
    "claim_execution_id",
    "runtime_packet_id",
    "workflow_id",
    "run_id",
    "generated_at",
    "selected_group_id",
    "selected_task_id",
    "taskpool_write_enabled",
    "taskpool_claim_enabled",
    "runtime_enabled",
    "runtime_worker_enabled",
    "runtime_module_enabled",
    "review_done_enabled",
    "model_call_enabled",
    "adapter_write_enabled",
    "external_side_effects_enabled",
    "review_done",
    "readback_verified",
    "rollback_plan",
    "boundary"
  ],
  "properties": {
    "done_execution_id": {"type": "string", "minLength": 1},
    "module_execution_id": {"type": "string", "minLength": 1},
    "runtime_execution_id": {"type": "string", "minLength": 1},
    "claim_execution_id": {"type": "string", "minLength": 1},
    "runtime_packet_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "selected_group_id": {"type": "string", "minLength": 1},
    "selected_task_id": {"type": "string", "minLength": 1},
    "taskpool_write_enabled": {"const": true},
    "taskpool_claim_enabled": {"const": true},
    "runtime_enabled": {"const": true},
    "runtime_worker_enabled": {"const": true},
    "runtime_module_enabled": {"const": true},
    "review_done_enabled": {"const": true},
    "model_call_enabled": {"const": false},
    "adapter_write_enabled": {"const": false},
    "external_side_effects_enabled": {"const": false},
    "review_done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_path",
        "group_id",
        "previous_status",
        "new_status",
        "executor_actor",
        "done_scope",
        "done_status",
        "verification_status",
        "verification",
        "readback_verified"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_path": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "previous_status": {"const": "review"},
        "new_status": {"const": "done"},
        "executor_actor": {"const": "workflow_runtime_review_done_gate"},
        "done_scope": {"const": "local_review_done_closeout_no_model_no_adapter"},
        "done_status": {"const": "done_local_review_closed"},
        "verification_status": {"const": "PASS"},
        "verification": {
          "type": "object",
          "required": ["verification_status", "verification_summary", "verification_digest"],
          "additionalProperties": true,
          "properties": {
            "verification_status": {"const": "PASS"},
            "verification_summary": {"type": "object"},
            "verification_digest": {"type": "string", "minLength": 1}
          }
        },
        "readback_verified": {"const": true}
      }
    },
    "readback_verified": {"const": true},
    "derived_refresh": {"type": ["object", "null"]},
    "rollback_plan": {"type": "string", "minLength": 1},
    "boundary": {"const": "runtime_review_done_closed_before_model_or_adapter"}
  }
}
