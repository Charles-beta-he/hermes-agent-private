{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/runtime_execution_worker_packet.schema.json",
  "title": "Hermes Workflow Runtime Execution Worker Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_execution_id",
    "claim_execution_id",
    "runtime_packet_id",
    "workflow_id",
    "run_id",
    "generated_at",
    "selected_group_id",
    "selected_task_id",
    "taskpool_write_enabled",
    "taskpool_claim_enabled",
    "runtime_enabled",
    "runtime_worker_enabled",
    "model_call_enabled",
    "adapter_write_enabled",
    "external_side_effects_enabled",
    "runtime_execution",
    "readback_verified",
    "rollback_plan",
    "boundary"
  ],
  "properties": {
    "runtime_execution_id": {"type": "string", "minLength": 1},
    "claim_execution_id": {"type": "string", "minLength": 1},
    "runtime_packet_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "selected_group_id": {"type": "string", "minLength": 1},
    "selected_task_id": {"type": "string", "minLength": 1},
    "taskpool_write_enabled": {"const": true},
    "taskpool_claim_enabled": {"const": true},
    "runtime_enabled": {"const": true},
    "runtime_worker_enabled": {"const": true},
    "model_call_enabled": {"const": false},
    "adapter_write_enabled": {"const": false},
    "external_side_effects_enabled": {"const": false},
    "runtime_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_path",
        "group_id",
        "previous_status",
        "new_status",
        "worker_actor",
        "worker_scope",
        "execution_status",
        "readback_verified"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_path": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "previous_status": {"const": "claimed"},
        "new_status": {"const": "running"},
        "worker_actor": {"const": "workflow_runtime_execution_worker"},
        "worker_scope": {"const": "local_noop_runtime_marker_no_model_no_adapter"},
        "execution_status": {"const": "running_noop_started_not_reviewed"},
        "readback_verified": {"const": true}
      }
    },
    "readback_verified": {"const": true},
    "rollback_plan": {"type": "string", "minLength": 1},
    "boundary": {"const": "runtime_execution_worker_done_before_review_done_or_adapter"}
  }
}
