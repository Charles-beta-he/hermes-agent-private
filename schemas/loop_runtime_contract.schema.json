{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/loop_runtime_contract.schema.json",
  "title": "Hermes LoopRuntimeContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "version",
    "objective",
    "authority_tier",
    "moves",
    "parts",
    "workspace_policy",
    "generator",
    "evaluator",
    "persistence",
    "scheduler",
    "budget",
    "human_gate",
    "evidence_refs",
    "rollback_plan",
    "external_side_effects"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,128}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 12
    },
    "authority_tier": {
      "enum": ["read-only", "local-reversible-dry-run", "local-reversible-write", "human-gated-external-write", "forbidden"]
    },
    "moves": {
      "type": "object",
      "required": ["discovery", "handoff", "verification", "persistence", "scheduling"],
      "additionalProperties": true
    },
    "parts": {
      "type": "object",
      "required": ["automations", "worktrees", "skills", "connectors", "sub_agents", "memory"],
      "additionalProperties": true
    },
    "workspace_policy": {
      "enum": ["read_only", "shared_repo", "git_worktree", "kanban_worktree", "sandbox"]
    },
    "generator": {"type": "object"},
    "evaluator": {
      "type": "object",
      "required": ["independent_from_generator", "can_veto", "evidence_refs"],
      "properties": {
        "independent_from_generator": {"const": true},
        "can_veto": {"const": true},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(command|artifact|proof|file|url|brainctl):"}
        }
      },
      "additionalProperties": true
    },
    "persistence": {"type": "object"},
    "scheduler": {
      "type": "object",
      "properties": {
        "enabled": {"const": false}
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": ["max_turns", "max_runtime_seconds", "max_subagents", "daily_token_budget"],
      "properties": {
        "max_turns": {"type": "integer", "minimum": 1},
        "max_runtime_seconds": {"type": "integer", "minimum": 1},
        "max_subagents": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_retries": {"type": "integer", "minimum": 0},
        "daily_token_budget": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "human_gate": {
      "type": "object",
      "required": ["required_before", "decision_packet"],
      "properties": {
        "required_before": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decision_packet": {"type": "string", "minLength": 12}
      },
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(command|artifact|proof|file|url|brainctl):"}
    },
    "rollback_plan": {"type": "string", "minLength": 12},
    "external_side_effects": {"const": false},
    "loop_runtime_enabled": {"const": false, "default": false}
  }
}
