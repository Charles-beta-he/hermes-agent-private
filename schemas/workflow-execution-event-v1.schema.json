{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/workflow-execution-event-v1.schema.json",
  "title": "Hermes WorkflowExecutionEventV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "workflow_execution_event_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_event_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^wee_[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "run_accepted",
        "run_started",
        "budget_reserved",
        "budget_settled",
        "budget_released",
        "leaf_started",
        "leaf_packet",
        "run_completed"
      ]
    },
    "payload": {
      "type": "object"
    },
    "event_id": {
      "type": "string",
      "pattern": "^wee_[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "previous_event_id",
    "idempotency_key",
    "occurred_at",
    "event_type",
    "payload",
    "event_id"
  ],
  "additionalProperties": false
}
