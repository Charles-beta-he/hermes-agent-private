{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/runtime_module_execution_packet.schema.json",
  "title": "Hermes Workflow Runtime Module Execution Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_execution_id",
    "runtime_execution_id",
    "claim_execution_id",
    "runtime_packet_id",
    "workflow_id",
    "run_id",
    "generated_at",
    "selected_group_id",
    "selected_task_id",
    "taskpool_write_enabled",
    "taskpool_claim_enabled",
    "runtime_enabled",
    "runtime_worker_enabled",
    "runtime_module_enabled",
    "model_call_enabled",
    "adapter_write_enabled",
    "external_side_effects_enabled",
    "module_execution",
    "readback_verified",
    "rollback_plan",
    "boundary"
  ],
  "properties": {
    "module_execution_id": {"type": "string", "minLength": 1},
    "runtime_execution_id": {"type": "string", "minLength": 1},
    "claim_execution_id": {"type": "string", "minLength": 1},
    "runtime_packet_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "selected_group_id": {"type": "string", "minLength": 1},
    "selected_task_id": {"type": "string", "minLength": 1},
    "taskpool_write_enabled": {"const": true},
    "taskpool_claim_enabled": {"const": true},
    "runtime_enabled": {"const": true},
    "runtime_worker_enabled": {"const": true},
    "runtime_module_enabled": {"const": true},
    "model_call_enabled": {"const": false},
    "adapter_write_enabled": {"const": false},
    "external_side_effects_enabled": {"const": false},
    "module_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_path",
        "group_id",
        "previous_status",
        "new_status",
        "executor_actor",
        "module_id",
        "module_scope",
        "execution_status",
        "validator_status",
        "module_output",
        "readback_verified"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_path": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "previous_status": {"const": "running"},
        "new_status": {"const": "review"},
        "executor_actor": {"const": "workflow_runtime_module_executor"},
        "module_id": {"const": "contract_acceptance_governance.local_validator.v1"},
        "module_scope": {"const": "local_deterministic_contract_validation_no_model_no_adapter"},
        "execution_status": {"const": "module_execution_review_ready"},
        "validator_status": {"const": "PASS"},
        "module_output": {
          "type": "object",
          "required": ["module_id", "module_scope", "validator_status", "validator_summary", "validator_digest"],
          "additionalProperties": true,
          "properties": {
            "module_id": {"const": "contract_acceptance_governance.local_validator.v1"},
            "module_scope": {"const": "local_deterministic_contract_validation_no_model_no_adapter"},
            "validator_status": {"const": "PASS"},
            "validator_summary": {"type": "object"},
            "validator_digest": {"type": "string", "minLength": 1}
          }
        },
        "readback_verified": {"const": true}
      }
    },
    "readback_verified": {"const": true},
    "derived_refresh": {"type": ["object", "null"]},
    "rollback_plan": {"type": "string", "minLength": 1},
    "boundary": {"const": "runtime_module_execution_done_before_done_model_or_adapter"}
  }
}
