{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/workflow_pack_manifest.schema.json",
  "title": "Hermes Workflow Pack Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "pack_name",
    "pack_version",
    "source_phase_range",
    "modules",
    "evidence_policy",
    "authority_boundaries",
    "runtime_flags",
    "verification_commands",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.0\\.0$"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "pack_name": {"type": "string", "minLength": 1},
    "pack_version": {"type": "string", "minLength": 1},
    "source_phase_range": {"type": "string", "minLength": 1},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "layer", "entrypoint", "inputs", "outputs", "risk_level", "human_gate", "side_effects"],
        "properties": {
          "module_id": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "risk_level": {"type": "string", "enum": ["read_only", "local_write", "scheduler_mutation", "external_side_effect"]},
          "human_gate": {"type": "string", "minLength": 1},
          "side_effects": {
            "type": "object",
            "required": ["cron_mutation", "model_generation", "credential_access", "external_dispatch"],
            "properties": {
              "cron_mutation": {"type": "boolean"},
              "model_generation": {"type": "boolean"},
              "credential_access": {"type": "boolean"},
              "external_dispatch": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_policy": {"type": "object"},
    "authority_boundaries": {"type": "array", "items": {"type": "string"}},
    "runtime_flags": {"type": "object"},
    "verification_commands": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": false
}
