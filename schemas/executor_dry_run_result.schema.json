{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/executor_dry_run_result.schema.json",
  "title": "Hermes Workflow Executor Dry-Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "run_id",
    "workflow_id",
    "executed_at",
    "dry_run_only",
    "local_reversible_only",
    "runtime_enabled",
    "taskpool_claim_enabled",
    "model_call_enabled",
    "adapter_write_enabled",
    "external_side_effects_enabled",
    "steps",
    "rollback_plan",
    "boundary"
  ],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "acceptance_bundle_id": {"type": "string", "minLength": 1},
    "executed_at": {"type": "string", "minLength": 1},
    "dry_run_only": {"const": true},
    "local_reversible_only": {"const": true},
    "runtime_enabled": {"const": false},
    "taskpool_claim_enabled": {"const": false},
    "model_call_enabled": {"const": false},
    "adapter_write_enabled": {"const": false},
    "external_side_effects_enabled": {"const": false},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "status", "source_criterion", "evidence"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["would_run", "blocked_by_boundary", "skipped"]},
          "source_criterion": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rollback_plan": {"type": "string", "minLength": 1},
    "boundary": {"const": "local_reversible_executor_stub_only_no_taskpool_no_model_no_adapter"}
  }
}
