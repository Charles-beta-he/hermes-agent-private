{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/workflow-leaf-packet-v1.schema.json",
  "title": "Hermes WorkflowLeafPacketV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "workflow_leaf_packet_v1"
    },
    "leaf_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "unverified"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "spawns": {
          "type": "integer",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "side_effect_ops": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "spawns",
        "wall_ms",
        "tool_calls",
        "tokens",
        "side_effect_ops"
      ],
      "additionalProperties": false
    },
    "continuation": {
      "type": [
        "object",
        "null"
      ]
    },
    "value_present": {
      "type": "boolean"
    },
    "result": {}
  },
  "required": [
    "schema_version",
    "leaf_id",
    "input_hash",
    "baseline_ref",
    "authority_ref",
    "status",
    "claims",
    "evidence",
    "uncertainty",
    "usage",
    "continuation",
    "value_present",
    "result"
  ],
  "additionalProperties": false
}
