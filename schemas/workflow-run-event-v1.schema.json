{
  "$id": "https://hermes-agent.local/schemas/workflow-run-event-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "workflow_run_event_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
        },
        {
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "previous_event_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wre_[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
        },
        {
          "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
            },
            {
              "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            }
          ]
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
            },
            {
              "pattern": "[^\\u0009-\\u000d\\u001c-\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            }
          ]
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "producer",
        "artifact_path",
        "artifact_digest"
      ],
      "additionalProperties": false
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "proposed"
            },
            "to": {
              "type": "string",
              "const": "claimed"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "claimed"
            },
            "to": {
              "type": "string",
              "const": "running"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "running"
            },
            "to": {
              "type": "string",
              "const": "review"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "const": "review"
            },
            "to": {
              "type": "string",
              "const": "done"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Hermes WorkflowRunTransitionV1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^wre_[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "previous_event_id",
    "idempotency_key",
    "occurred_at",
    "provenance",
    "transition",
    "event_id"
  ],
  "additionalProperties": false,
  "title": "Hermes WorkflowRunEventV1"
}
