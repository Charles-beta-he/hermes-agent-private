{
  "$id": "https://hermes-agent.local/schemas/workflow-runtime-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "workflow_runtime_manifest_v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "identity_schema_version": {
      "type": "number",
      "const": 1
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "project_scope": {
      "type": "string",
      "minLength": 1
    },
    "profile_scope": {
      "type": "string",
      "minLength": 1
    },
    "tool_policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "reservation_ttl_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "hard_budget": {
      "type": "object",
      "properties": {
        "spawns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "side_effect_ops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "spawns",
        "wall_ms",
        "tool_calls",
        "tokens",
        "side_effect_ops"
      ],
      "additionalProperties": false
    },
    "leaves": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string",
            "minLength": 1
          },
          "isolation": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "$ref": "#/$defs/__schema0"
          },
          "output_schema": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          },
          "reserve": {
            "type": "object",
            "properties": {
              "spawns": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "wall_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tool_calls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "side_effect_ops": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "spawns",
              "wall_ms",
              "tool_calls",
              "tokens",
              "side_effect_ops"
            ],
            "additionalProperties": false
          },
          "evidence_kinds": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "command",
                "file",
                "api",
                "screenshot",
                "log",
                "readback"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "adapter",
          "isolation",
          "input",
          "output_schema",
          "reserve"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "identity_schema_version",
    "baseline_ref",
    "project_scope",
    "profile_scope",
    "tool_policy_ref",
    "model_contract_ref",
    "authority_ref",
    "max_concurrency",
    "reservation_ttl_ms",
    "hard_budget",
    "leaves"
  ],
  "additionalProperties": false,
  "title": "Hermes WorkflowRuntimeManifestV1",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
