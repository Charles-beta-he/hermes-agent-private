{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.local/schemas/action_contract.schema.json",
  "title": "Hermes ActionContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "version",
    "callable_surfaces",
    "authority_tier",
    "idempotency_key",
    "input_schema",
    "output_schema",
    "evidence_refs",
    "rollback_plan",
    "compensation_path",
    "external_side_effects"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{2,96}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "callable_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["cli", "dashboard", "agent", "http", "mcp", "a2a", "cron", "gateway"]
      }
    },
    "authority_tier": {
      "enum": ["read-only", "budget-handoff", "local-reversible", "human-gated-external", "forbidden"]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(command|artifact|proof|file|url|brainctl):"
      }
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 12
    },
    "compensation_path": {
      "type": "string",
      "minLength": 12
    },
    "external_side_effects": {
      "const": false
    },
    "runtime_executor_enabled": {
      "const": false,
      "default": false
    },
    "package_imports": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
