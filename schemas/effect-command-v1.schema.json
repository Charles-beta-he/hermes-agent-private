        },
        {
          "pattern": "\\S"
        }
      ],
      "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
    },
    "reconcile_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
        },
        {
          "pattern": "\\S"
        }
      ],
      "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "adapter_id",
    "operation",
    "target",
    "payload_digest",
    "idempotency_key",
    "issuer_id",
    "policy_revision",
    "config_revision",
