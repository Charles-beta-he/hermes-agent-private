          ],
          "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
        },
        "target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
            },
            {
              "pattern": "\\S"
            }
          ],
          "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
        }
      },
      "required": [
        "target_kind",
        "target_ref"
      ],
      "additionalProperties": false
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
