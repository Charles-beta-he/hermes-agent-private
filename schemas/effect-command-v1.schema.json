  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "effect_command_v1",
      "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
        },
        {
          "pattern": "\\S"
        }
      ],
      "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "target_kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
