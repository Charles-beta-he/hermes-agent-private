{
  "$id": "https://hermes-agent.local/schemas/workflow-definition-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "workflow_definition_v1"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "non_goals": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "allOf": [
          {
            "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
          },
          {
            "pattern": "\\S"
          }
        ]
      }
    },
    "constraints": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "allOf": [
          {
            "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
          },
          {
            "pattern": "\\S"
          }
        ]
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "max_side_effect": {
          "type": "string",
          "enum": [
            "none",
            "local_read",
            "local_write",
            "external_read",
            "external_write"
          ]
        },
        "allowed_capabilities": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          }
        }
      },
      "required": [
        "max_side_effect",
        "allowed_capabilities"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "allOf": [
              {
                "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
              },
              {
                "pattern": "\\S"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "explore",
              "plan",
              "execute",
              "verify"
            ]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          },
          "depends_on": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,127}$"
            }
          },
          "inputs": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "allOf": [
                {
                  "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
                },
                {
                  "pattern": "\\S"
                }
              ]
            }
          },
          "outputs": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "allOf": [
                {
                  "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
                },
                {
                  "pattern": "\\S"
                }
              ]
            }
          },
          "writes": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "allOf": [
                {
                  "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
                },
                {
                  "pattern": "\\S"
                }
              ]
            }
          },
          "authority": {
            "type": "object",
            "properties": {
              "side_effect": {
                "type": "string",
                "enum": [
                  "none",
                  "local_read",
                  "local_write",
                  "external_read",
                  "external_write"
                ]
              },
              "capabilities": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{0,127}$"
                }
              }
            },
            "required": [
              "side_effect",
              "capabilities"
            ],
            "additionalProperties": false
          },
          "acceptance": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9._-]{0,127}$"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "allOf": [
                    {
                      "pattern": "^[^\\u0000-\\u0008\\u000e-\\u001b\\u007f-\\u0084\\u0086-\\u009f\\ud800-\\udfff]*$"
                    },
                    {
                      "pattern": "\\S"
                    }
                  ]
                },
                "evidence_required": {
                  "minItems": 1,
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "command",
                      "file",
                      "api",
                      "screenshot",
                      "log",
                      "readback"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "claim",
                "evidence_required"
              ],
              "additionalProperties": false
            }
          },
          "verifies": {
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,127}$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "role",
          "owner",
          "depends_on",
          "inputs",
          "outputs",
          "writes",
          "authority",
          "acceptance",
          "verifies"
        ],
        "additionalProperties": false
      }
    },
    "loop_policy": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "repeated_failure_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "on_repeated_failure": {
          "type": "string",
          "enum": [
            "switch_path",
            "human_gate",
            "terminal_failure"
          ]
        }
      },
      "required": [
        "max_iterations",
        "repeated_failure_limit",
        "on_repeated_failure"
      ],
      "additionalProperties": false
    },
    "stop_conditions": {
      "minItems": 2,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "success",
          "blocked",
          "human_gate",
          "terminal_failure",
          "cancelled",
          "context_exhausted",
          "stale"
        ]
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "required_fields": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "goal",
              "task_states",
              "artifacts",
              "evidence",
              "blockers",
              "next_step",
              "authority_state"
            ]
          }
        }
      },
      "required": [
        "required_fields"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "title",
    "goal",
    "non_goals",
    "constraints",
    "authority",
    "tasks",
    "loop_policy",
    "stop_conditions",
    "handoff"
  ],
  "additionalProperties": false,
  "title": "Hermes WorkflowDefinitionV1"
}
