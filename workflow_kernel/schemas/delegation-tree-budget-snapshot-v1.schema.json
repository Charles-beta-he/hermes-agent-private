{
  "$id": "https://hermes-agent.local/schemas/delegation-tree-budget-snapshot-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "hermes_delegation_tree_budget_snapshot_v1"
    },
    "tree_budget_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "snapshot_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "remaining_node_capacity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "schema_version",
    "tree_budget_id",
    "snapshot_revision",
    "remaining_node_capacity"
  ],
  "additionalProperties": false,
  "title": "Hermes DelegationTreeBudgetSnapshotV1"
}
