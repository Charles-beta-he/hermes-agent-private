{
  "$id": "https://hermes-agent.local/schemas/delegation-expansion-projection-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "delegation_expansion_projection_v1"
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority_granted": {
      "type": "boolean",
      "const": false
    },
    "executable": {
      "type": "boolean",
      "const": false
    },
    "child_task_ids": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,127}$"
      },
      "uniqueItems": true
    },
    "synthesis_task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "requested_child_nodes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 256
    }
  },
  "required": [
    "schema_version",
    "definition_digest",
    "plan_digest",
    "proposal_digest",
    "authority_granted",
    "executable",
    "child_task_ids",
    "synthesis_task_id",
    "requested_child_nodes"
  ],
  "additionalProperties": false,
  "title": "Hermes DelegationExpansionProjectionV1"
}
